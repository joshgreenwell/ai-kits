{
  "name": "personal-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:db": "node scripts/test-db.mjs",
    "test:routing:db": "node scripts/test-db.mjs",
    "usage-schema": "node --import tsx scripts/build-usage-schema.mjs",
    "publish:report": "node scripts/publish.mjs",
    "publish:assets": "node scripts/publish-assets.mjs",
    "predev": "node scripts/build-report-ui.mjs",
    "prebuild": "node scripts/build-report-ui.mjs && node --import tsx scripts/build-usage-schema.mjs",
    "report-ui": "node scripts/build-report-ui.mjs",
    "test:collector": "python3 -m unittest discover -s tests -p '*_test.py'"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.3.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}

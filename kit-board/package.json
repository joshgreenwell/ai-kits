{
  "name": "personal-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:routing:db": "node scripts/test-routing-db.mjs",
    "publish:report": "node scripts/publish.mjs",
    "publish:assets": "node scripts/publish-assets.mjs",
    "predev": "node scripts/build-report-ui.mjs",
    "prebuild": "node scripts/build-report-ui.mjs",
    "report-ui": "node scripts/build-report-ui.mjs",
    "test:collector": "python3 -m unittest discover -s tests -p '*_test.py'",
    "collectors:bundle": "python3 scripts/build-collector-bundles.py"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.2.6",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "postgres": "3.4.8",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.28.2",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}

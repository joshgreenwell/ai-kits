    "provenance": "Public list prices read from the Anthropic pricing page on 2026-09-14 and checked against the Mac Claude analyzer’s 2026.09.07 report rows for Fable 5.1, Opus 5, Opus 4.8, and Sonnet 5; the single period has no start date, so the same rates apply to a request of any date and price changes before that date are not modeled.",
    "sources": [
      {
        "label": "Anthropic model pricing",
        "url": "https://platform.claude.com/docs/en/about-claude/pricing"
      }
    ],
    "rules": {
      "cache_read_rate": "per model cached_input rate (0.1x base input; 0.025x on Fable 5.1 and Mythos 5.1)",
      "cache_write_5m": "1.25x base input",
      "cache_write_1h": "2x base input",
      "batch": "50% of standard input and output, cache multipliers stack",
      "priority": "standard list rates, flagged",
      "flex": "not priced",
      "fast": "Opus 5 and Opus 4.8 only, from the recorded speed",
      "long_context": "Claude 4.6 and later (full_context_window_at_standard_rates) bill the full context window at standard rates, so their long band equals their short band; earlier models had a premium that is not modeled and their long-band requests stay unpriced",
      "model_ids": "dated Claude model ids match through the aliases and through a trailing -YYYYMMDD suffix"
    },

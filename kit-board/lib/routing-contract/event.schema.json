{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:personal-observatory:routing-event:v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event_type": {
          "type": "string",
          "const": "task.registered"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "task_type": {
              "type": "string",
              "enum": [
                "implementation",
                "debugging",
                "review",
                "architecture",
                "documentation",
                "general"
              ]
            },
            "complexity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "risk": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "workload": {
              "type": "string",
              "enum": [
                "work",
                "studio"
              ]
            },
            "parent_task_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "request_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "task_type",
            "complexity",
            "risk",
            "workload",
            "parent_task_id",
            "request_hash"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "task_id",
        "attempt_id",
        "sequence",
        "event_type",
        "occurred_at",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event_type": {
          "type": "string",
          "const": "route.decided"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object",
          "properties": {
            "policy_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
            },
            "policy_version": {
              "type": "integer",
              "minimum": 1
            },
            "policy_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "mode": {
              "type": "string",
              "enum": [
                "shadow",
                "execute"
              ]
            },
            "rule_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
            },
            "selected_candidate": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
            },
            "baseline_candidate": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
            },
            "reason_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
              },
              "maxItems": 30
            },
            "rejected": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "candidate_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
                  }
                },
                "required": [
                  "candidate_id",
                  "reason"
                ],
                "additionalProperties": false
              },
              "maxItems": 30
            },
            "quota": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "candidate_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "green",
                      "yellow",
                      "red",
                      "unknown",
                      "unavailable"
                    ]
                  },
                  "sample_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
                    },
                    "maxItems": 20
                  }
                },
                "required": [
                  "candidate_id",
                  "state",
                  "sample_ids"
                ],
                "additionalProperties": false
              },
              "maxItems": 30
            },
            "override": {
              "type": "boolean"
            },
            "experiment_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
            },
            "arm": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "baseline",
                "routed",
                null
              ]
            }
          },
          "required": [
            "policy_id",
            "policy_version",
            "policy_hash",
            "mode",
            "rule_id",
            "selected_candidate",
            "baseline_candidate",
            "reason_codes",
            "rejected",
            "quota",
            "override",
            "experiment_id",
            "arm"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "task_id",
        "attempt_id",
        "sequence",
        "event_type",
        "occurred_at",
        "payload"
      ],
      "additionalProperties": false
    },

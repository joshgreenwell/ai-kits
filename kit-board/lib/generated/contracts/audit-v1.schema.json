{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshgreenwell/ai-kits/blob/main/kit-board/lib/generated/contracts/audit-v1.schema.json",
  "title": "Luumen AI audit",
  "description": "An HTML report, served sandboxed. coverage.presentation \"full-audit\" marks the report /audit opens by default.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "period_key": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}(?:-\\d{2})?$"
    },
    "subject_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9._:@+-]+$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9._:@+-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "produced_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "coverage": {
      "default": {},
      "type": "object",
      "properties": {
        "presentation": {
          "description": "\"full-audit\" for a complete scored assessment.",
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "payload": {
      "type": "object",
      "properties": {
        "markdown": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "html": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3500000
    }
  },
  "required": [
    "schema_version",
    "period_key",
    "subject_key",
    "idempotency_key",
    "title",
    "produced_at",
    "status",
    "payload",
    "html"
  ],
  "additionalProperties": false
}

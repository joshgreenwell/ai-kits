# Copy to ignored .env.local; placeholders are not working credentials.
DATABASE_URL=postgresql://personal_hub_app:REPLACE@db.example:5432/postgres
# The AWS RDS CA bundle for the cluster's region, newlines written as \n (see docs/aurora-cutover.md).
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nRDS_CA_BUNDLE\n-----END CERTIFICATE-----"
SITE_URL=http://localhost:3100
SITE_PASSWORD_HASH=scrypt:SALT:HASH
SESSION_SECRET=GENERATE_RANDOM_SECRET
# {"producer-name":{"hash":"SHA256_OF_PUBLISH_KEY","kinds":["usage"]}}
INGEST_KEYS_JSON={}
# Optional additive usage-only publisher keys for credential recovery or rotation.
USAGE_INGEST_KEYS_JSON={}
# Optional scheduled sync endpoints; leave absent until explicitly configured.
# CRON_SECRET=GENERATE_SEPARATE_RANDOM_SECRET
# LEGACY_USAGE_CONFIG_JSON={"endpoint":"EXISTING_ALLOWLISTED_ENDPOINT","api_key":"REPLACE","sites_bypass_token":"REPLACE"}

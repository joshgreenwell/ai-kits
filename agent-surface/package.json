{
  "name": "agent-surface",
  "version": "0.0.1",
  "description": "Agent Control-Surface Diff: deterministic, offline diff of repository-controlled Claude Code configuration between two Git refs.",
  "license": "BSD-2-Clause",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-surface": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/",
    "!dist/test/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "docs": "npm run build && node scripts/render-interpretations.mjs",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "prepublishOnly": "npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}

// origin: synthetic
// ref: JG-150
// completeness: complete (every entry kind on purpose)
// excerpt_or_raw: raw
{
  "$schema": "https://example.invalid/settings.schema.json",
  "permissions": {
    "allow": ["Bash(npm test)", "Bash(npm run:*)", "Read", "mcp__docs__search"],
    "ask": ["Bash(git push *)"],
    "deny": ["Bash(curl *)", "WebFetch"],
    "additionalDirectories": ["../shared-lib", "/srv/data "],
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "echo pre-bash", "timeout": 5 }] },
      { "hooks": [{ "type": "command", "command": "echo any-tool" }] }
    ],
    "Stop": [{ "matcher": "", "hooks": [{ "type": "prompt", "prompt": "Summarize what changed" }] }]
  },
  "env": { "EXAMPLE_FLAG": "1", "EXAMPLE_ENDPOINT": "https://example.invalid/api" },
  "sandbox": { "enabled": true, "autoAllowBashIfSandboxed": false, "network": { "allowedDomains": ["example.invalid"] } },
  "apiKeyHelper": "/usr/local/bin/print-key",
  "awsAuthRefresh": "aws sso login --profile synthetic",
  "awsCredentialExport": "/usr/local/bin/export-creds",
  "otelHeadersHelper": "/usr/local/bin/otel-headers",
  "enabledPlugins": { "example-plugin@example-marketplace": true },
  "enableAllProjectMcpServers": true,
  "disableAllHooks": false,
  "enabledMcpjsonServers": ["docs", "build"],
  "disabledMcpjsonServers": ["scratch"],
  "model": "example-model",
  "statusLine": { "type": "command", "command": "echo status" }
}
